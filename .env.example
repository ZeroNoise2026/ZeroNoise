# zeroNoise — the ONE env file for every app. Copy to .env (gitignored), or let
# `./dev.sh setup` scaffold it. Every service reads this file locally; in Cloud
# Run, deploy.sh injects the same keys (secrets via Secret Manager).

# ═══ Credentials (secrets) ═══
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
SUPABASE_URL=https://xxxxx.supabase.co
# Service-role key (server-side only, bypasses RLS)
SUPABASE_KEY=your-supabase-service-role-key
# Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
FINNHUB_API_KEY=your-finnhub-api-key
FMP_API_KEY=your-fmp-api-key
EDGAR_USER_AGENT=YourName your@email.com

# ═══ Frontend (Vite exposes only VITE_* to the browser) ═══
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_xxx>
# Override the backend URL; unset uses the Vite dev proxy.
# VITE_API_URL=https://<your-cloud-run-backend>.run.app

# ═══ Service URLs (local defaults) ═══
EMBEDDING_SERVICE_URL=http://localhost:8002
QUESTION_SERVICE_URL=http://localhost:8003
# Backend CORS in production (./deploy.sh cors sets it for you)
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ═══ Models ═══
# Backend summaries + briefings
LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=medium
# Research reports (libs/research)
LLM_MODEL_SUMMARY=claude-sonnet-5-5
# LLM_EFFORT_SUMMARY=high
# Question service
LLM_MODEL_QA=claude-haiku-5-5
LLM_MODEL_CLASSIFY=claude-haiku-5-5
# LLM_EFFORT_QA=medium
# LLM_MAX_TOKENS=16000

# ═══ Embedding service ═══
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ═══ Tuning (defaults shown) ═══
# MAX_CONTEXT_CHARS=380000
# SEMANTIC_TOP_K=8
# SIMILARITY_THRESHOLD=0.3
# TIER2_CACHE_MAX_SIZE=200
# HOT_PROMOTION_THRESHOLD=10
# BRIEFING_WINDOW_MINUTES=15
# DEFAULT_TICKERS=AAPL,MSFT,GOOGL
# REPORT_OUTPUT_DIR=output
