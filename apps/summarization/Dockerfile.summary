# summary CLI (batch reports for every tracked ticker). Build context is the
# REPO ROOT so the image can install the shared libs/ packages:
#   docker build -f apps/summarization/Dockerfile.summary .
FROM python:3.11-slim

WORKDIR /app

COPY libs/common /libs/common
COPY libs/research /libs/research
COPY libs/skills /libs/skills
COPY apps/summarization/requirements.txt .
RUN pip install --no-cache-dir /libs/common /libs/research /libs/skills -r requirements.txt

COPY apps/summarization/config.py .
COPY apps/summarization/shared/ shared/
COPY apps/summarization/summary/ summary/

RUN mkdir -p /app/output

CMD ["python", "-m", "summary.run", "--all"]
